---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  paginaTitel: string;
  rol: "lid" | "coach";
  breed?: boolean;
}

const { title, paginaTitel, rol, breed = false } = Astro.props;
const pad = Astro.url.pathname;

const iconen: Record<string, string> = {
  vandaag:
    '<path d="M4 11.5 12 4l8 7.5"/><path d="M6.5 9.8V20h11V9.8"/><path d="M9.8 20v-5.5h4.4V20"/>',
  training:
    '<path d="M7.5 8v8M16.5 8v8"/><rect x="4" y="9.5" width="3.5" height="5" rx="1"/><rect x="16.5" y="9.5" width="3.5" height="5" rx="1"/><path d="M7.5 12h9"/><path d="M2 10.5v3M22 10.5v3"/>',
  toegang:
    '<rect x="4" y="4" width="6.5" height="6.5" rx="1.2"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.2"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.2"/><path d="M13.5 13.5h2.8v2.8h-2.8zM17.2 17.2h2.8V20h-2.8zM17.2 13.5H20M13.5 17.2v2.8"/>',
  voeding:
    '<path d="M12 8.5c1-2.8 3.2-4 5.2-3.4 2.5.7 3.6 3.6 2.4 6.8-1.3 3.6-4.3 6.6-7.6 8.1-3.3-1.5-6.3-4.5-7.6-8.1-1.2-3.2-.1-6.1 2.4-6.8 2-.6 4.2.6 5.2 3.4z"/><path d="M12 8.5V6"/>',
  voortgang:
    '<path d="M4 19.5h16"/><path d="M6.5 19.5V13M11 19.5V8.5M15.5 19.5V11M20 19.5V5.5"/>',
  overzicht:
    '<rect x="4" y="4" width="7" height="9" rx="1.5"/><rect x="13" y="4" width="7" height="5.5" rx="1.5"/><rect x="13" y="11.5" width="7" height="8.5" rx="1.5"/><rect x="4" y="15" width="7" height="5" rx="1.5"/>',
  leden:
    '<circle cx="9" cy="8.5" r="3.2"/><path d="M3.5 19.5c.6-3.2 2.8-5 5.5-5s4.9 1.8 5.5 5"/><circle cx="16.8" cy="9.5" r="2.5"/><path d="M15.6 14.7c2.6.1 4.4 1.8 4.9 4.3"/>',
  agenda:
    '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 9.5h17M8 3v3.5M16 3v3.5"/><path d="M8.5 14.5l2.2 2.2 4.6-4.6"/>',
};

type NavItem = { href: string; label: string; icoon: string; center?: boolean; alleenDesktop?: boolean };

const lidNav: NavItem[] = [
  { href: "/app/", label: "Vandaag", icoon: "vandaag" },
  { href: "/app/training/", label: "Training", icoon: "training" },
  { href: "/app/toegang/", label: "Toegang", icoon: "toegang", center: true },
  { href: "/app/community/", label: "Community", icoon: "leden" },
  { href: "/app/voeding/", label: "Voeding", icoon: "voeding", alleenDesktop: true },
  { href: "/app/voortgang/", label: "Voortgang", icoon: "voortgang" },
];

const coachNav: NavItem[] = [
  { href: "/coach/", label: "Overzicht", icoon: "overzicht" },
  { href: "/coach/leden/", label: "Leden", icoon: "leden" },
  { href: "/coach/agenda/", label: "Agenda", icoon: "agenda" },
];

const nav = rol === "lid" ? lidNav : coachNav;

function isActief(href: string): boolean {
  if (href === "/app/" || href === "/coach/") {
    return pad === href || pad === href.slice(0, -1);
  }
  return pad.startsWith(href) || pad.startsWith(href.slice(0, -1));
}

const initialen = rol === "lid" ? "SV" : "DA";
const rolLabel = rol === "lid" ? "Sanne Visser" : "Coach Daan";
const rolSub = rol === "lid" ? "Limited Member" : "Trainer";
---

<BaseLayout title={title}>
  <div class="min-h-svh lg:grid lg:grid-cols-[264px_1fr]">
    <!-- Sidebar desktop -->
    <aside class="hidden lg:flex flex-col border-r border-white/8 bg-coal-900 px-5 pt-7 pb-5 sticky top-0 h-svh">
      <a href="/" class="flex items-center gap-3 px-2">
        <img src="/img/logo-base-wit.png" alt="BASE Training" class="h-6 w-auto" />
      </a>
      <p class="px-2 mt-1.5 text-[11px] uppercase tracking-[0.18em] text-white/35 font-medium">Training Studio Vlissingen</p>

      <nav class="mt-9 flex flex-col gap-1">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                "flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm font-medium transition-colors",
                isActief(item.href) ? "bg-volt text-coal-950" : "text-white/65 hover:bg-white/5 hover:text-white",
              ]}
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5 shrink-0" set:html={iconen[item.icoon]} />
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="mt-auto">
        <div class="flex items-center gap-3 rounded-2xl bg-coal-800 border border-white/8 px-3.5 py-3">
          <span class="grid size-9 shrink-0 place-items-center rounded-full bg-volt text-coal-950 font-display font-bold text-xs">{initialen}</span>
          <div class="min-w-0">
            <p class="truncate text-sm font-semibold">{rolLabel}</p>
            <p class="text-xs text-white/45">{rolSub}</p>
          </div>
        </div>
        <a href="/" class="mt-2 block px-3.5 py-1.5 text-xs text-white/40 hover:text-white/70 transition-colors">Wissel van rol</a>
        <p class="px-3.5 mt-4 text-[11px] text-white/30">Made By <span class="agensea-glow font-semibold">Agensea</span></p>
      </div>
    </aside>

    <div class="flex min-h-svh flex-col">
      <!-- Frosted header mobiel -->
      <header class="lg:hidden sticky top-0 z-40 border-b border-white/8 bg-coal-950/75 backdrop-blur-xl pt-safe">
        <div class="flex h-14 items-center justify-between px-5">
          <a href="/" class="flex items-center">
            <img src="/img/logo-base-wit.png" alt="BASE Training" class="h-4.5 w-auto" />
          </a>
          <span class="display text-sm font-semibold text-white/85">{paginaTitel}</span>
          <a href="/" aria-label="Wissel van rol" class="grid size-8 place-items-center rounded-full bg-volt text-coal-950 font-display font-bold text-[11px]">{initialen}</a>
        </div>
      </header>

      <!-- Header desktop -->
      <header class="hidden lg:block border-b border-white/8">
        <div class:list={["mx-auto flex h-16 items-center px-8", breed ? "max-w-6xl" : "max-w-3xl"]}>
          <h1 class="display text-lg font-semibold">{paginaTitel}</h1>
        </div>
      </header>

      <main class:list={["mx-auto w-full flex-1 px-5 pt-5 pb-32 lg:px-8 lg:pt-8 lg:pb-16", breed ? "max-w-6xl" : "max-w-3xl"]}>
        <slot />
      </main>
    </div>
  </div>

  <!-- Tabbar mobiel -->
  <nav class="lg:hidden fixed inset-x-0 bottom-0 z-40 border-t border-white/8 bg-coal-950/80 backdrop-blur-xl pb-safe">
    <div class="mx-auto flex max-w-md items-stretch justify-around px-2">
      {
        nav.filter((item) => !item.alleenDesktop).map((item) =>
          item.center ? (
            <a href={item.href} aria-label={item.label} class="relative -top-4 grid place-items-center">
              <span
                class:list={[
                  "grid size-14 place-items-center rounded-full border-4 border-coal-950 transition-colors",
                  isActief(item.href) ? "bg-white text-coal-950" : "bg-volt text-coal-950",
                ]}
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="size-6" set:html={iconen[item.icoon]} />
              </span>
            </a>
          ) : (
            <a
              href={item.href}
              class:list={[
                "flex flex-1 flex-col items-center gap-1 pt-2.5 pb-2 text-[10px] font-medium transition-colors",
                isActief(item.href) ? "text-volt" : "text-white/50",
              ]}
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5.5" set:html={iconen[item.icoon]} />
              {item.label}
            </a>
          ),
        )
      }
    </div>
  </nav>
</BaseLayout>
