---
import AppShell from "../../layouts/AppShell.astro";
import SpierKaart from "../../components/SpierKaart.astro";
import { SCHEMA, KRACHT_VERLOOP, OEFENING_SPIEREN, SPIEREN, trainingVanVandaag, volgendeTraining } from "../../data/demo";

const alleOefeningen = SCHEMA.dagen.flatMap((d) => d.oefeningen);

function spierNamen(slugs: string[]): string {
  return slugs.map((slug) => SPIEREN[slug]?.naam ?? slug).join(", ");
}

const vandaag = trainingVanVandaag();
const actieveDag = vandaag?.id ?? volgendeTraining().dag.id;

// Korte progressieregel per oefening, alleen als er verloop-data is
function progressieVan(id: string): { tekst: string; delta: number } | null {
  const verloop = KRACHT_VERLOOP[id];
  if (!verloop) return null;
  const delta = Math.round((verloop.punten[verloop.punten.length - 1]!.kg - verloop.punten[0]!.kg) * 10) / 10;
  const tekst = delta > 0 ? `▲ +${delta} ${verloop.eenheid} in 8 weken` : delta < 0 ? `▼ ${delta} ${verloop.eenheid} in 8 weken` : "≈ gelijk gebleven";
  return { tekst, delta };
}
---

<AppShell title="Training | BASE app" paginaTitel="Training" rol="lid">
  <section class="rise-in flex items-end justify-between gap-4">
    <div>
      <p class="text-xs uppercase tracking-[0.18em] text-volt font-display font-medium">{SCHEMA.blok}</p>
      <h2 class="display mt-1 text-2xl font-extrabold">{SCHEMA.naam}</h2>
      <p class="mt-1 text-sm text-white/50">Week {SCHEMA.week} van {SCHEMA.totaalWeken} - opgesteld door Daan</p>
    </div>
    <div class="hidden sm:block text-right">
      <p class="display text-2xl font-bold text-volt" id="voortgang-label">0%</p>
      <p class="text-xs text-white/45">van vandaag</p>
    </div>
  </section>

  <div class="rise-in rise-in-1 mt-4 h-1.5 overflow-hidden rounded-full bg-white/8">
    <div id="voortgang-balk" class="h-full w-0 rounded-full bg-volt transition-all duration-500"></div>
  </div>

  {!vandaag && (
    <p class="mt-4 rounded-xl border border-white/10 bg-coal-800 px-4 py-3 text-sm text-white/60">
      Vandaag staat er geen training gepland. Bekijk alvast je volgende trainingsdag.
    </p>
  )}

  <div class="rise-in rise-in-1 mt-5 flex gap-2 overflow-x-auto no-scrollbar">
    {
      SCHEMA.dagen.map((dag) => (
        <button
          type="button"
          data-dagknop={dag.id}
          class:list={[
            "dagknop shrink-0 rounded-xl px-4 py-2.5 text-left transition-colors border",
            dag.id === actieveDag ? "bg-volt text-coal-950 border-volt" : "bg-coal-800 text-white/70 border-white/8",
          ]}
        >
          <span class="display block text-sm font-bold">{dag.label}</span>
          <span class="block text-[11px] opacity-70">{dag.naam}</span>
        </button>
      ))
    }
  </div>

  {
    SCHEMA.dagen.map((dag) => (
      <section data-dagsectie={dag.id} class:list={["mt-5 flex-col gap-3", dag.id === actieveDag ? "flex" : "hidden"]}>
        {dag.oefeningen.map((oef) => (
          <article
            class="oefening-kaart rounded-2xl border border-white/8 bg-coal-800 p-5"
            data-dag={dag.id}
            data-oef={oef.id}
            data-sets={oef.sets}
            data-reps={oef.reps}
            data-gewicht={oef.gewicht ?? ""}
            data-rust={oef.rustSec}
          >
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="display text-base font-bold">{oef.naam}</h3>
                <p class="mt-0.5 text-xs text-white/45">
                  {oef.spiergroep} - <span data-veld="setsreps">{oef.sets} x {oef.reps}</span> - rust {Math.floor(oef.rustSec / 60) > 0 ? `${Math.floor(oef.rustSec / 60)}:${String(oef.rustSec % 60).padStart(2, "0")}` : `${oef.rustSec} sec`}
                </p>
              </div>
              <div data-veld="gewichtblok" class:list={[oef.gewicht === null && "hidden"]}>
                <div class="flex items-center gap-1 rounded-xl bg-coal-950 border border-white/10 p-1">
                  <button type="button" data-actie="gewicht-min" class="grid size-8 place-items-center rounded-lg text-white/60 hover:bg-white/8" aria-label="Gewicht omlaag">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" class="size-4"><path d="M6 12h12" /></svg>
                  </button>
                  <span class="display min-w-14 text-center text-sm font-bold" data-veld="gewicht">{oef.gewicht} kg</span>
                  <button type="button" data-actie="gewicht-plus" class="grid size-8 place-items-center rounded-lg text-white/60 hover:bg-white/8" aria-label="Gewicht omhoog">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" class="size-4"><path d="M12 6v12M6 12h12" /></svg>
                  </button>
                </div>
              </div>
            </div>
            {oef.cue && <p class="mt-2 text-xs text-white/40">Tip: {oef.cue}</p>}
            <button
              type="button"
              data-techniek-open={oef.id}
              class="mt-3 inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-coal-950 px-3 py-1.5 text-xs font-semibold text-white/70 transition-colors hover:border-volt/40 hover:text-white"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="size-3.5 text-volt"><path d="M8 5.5v13l11-6.5z" /></svg>
              Techniek en spieren
            </button>
            <div class="mt-4 flex flex-wrap gap-2" data-veld="sets" />
            {(() => {
              const prog = progressieVan(oef.id);
              return (
                prog && (
                  <a href={`/app/voortgang/?oefening=${oef.id}`} class="mt-4 flex items-center justify-between border-t border-white/8 pt-3 text-xs text-white/45 transition-colors hover:text-white">
                    <span class="flex items-center gap-1.5">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="size-3.5"><path d="M3.5 19.5l5-7 4 3.5 7.5-9.5" /><circle cx="20" cy="6.5" r="1.6" fill="currentColor" stroke="none" /></svg>
                      Progressie
                    </span>
                    <span class:list={["flex items-center gap-1 font-semibold", prog.delta > 0 ? "text-emerald-300" : prog.delta < 0 ? "text-red-300" : "text-white/40"]}>
                      {prog.tekst}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5"><path d="M9 6l6 6-6 6" /></svg>
                    </span>
                  </a>
                )
              );
            })()}
          </article>
        ))}

        <button
          type="button"
          data-actie="afronden"
          data-dag={dag.id}
          class="mt-2 w-full rounded-2xl bg-volt py-4 font-display text-base font-bold uppercase tracking-wide text-coal-950 transition-transform active:scale-[0.99] disabled:opacity-40"
        >
          Training afronden
        </button>
      </section>
    ))
  }

  <!-- Rusttimer -->
  <div id="rust-timer" class="pointer-events-none fixed inset-x-0 bottom-24 z-50 flex justify-center px-5 opacity-0 transition-all duration-300 translate-y-4 lg:bottom-8">
    <div class="pointer-events-auto flex items-center gap-4 rounded-2xl border border-volt/30 bg-coal-900/95 px-5 py-3.5 backdrop-blur-xl volt-glow">
      <div>
        <p class="text-[11px] uppercase tracking-wide text-white/50 font-medium">Rust</p>
        <p class="display text-2xl font-bold tabular-nums text-volt" id="rust-tijd">1:30</p>
      </div>
      <button type="button" id="rust-skip" class="rounded-xl bg-white/10 px-4 py-2 text-sm font-semibold hover:bg-white/15">Klaar</button>
    </div>
  </div>

  <!-- Afgerond overlay -->
  <div id="klaar-overlay" class="fixed inset-0 z-[60] hidden items-center justify-center bg-coal-950/90 backdrop-blur-sm px-6">
    <div class="w-full max-w-sm rounded-3xl border border-volt/25 bg-coal-900 p-8 text-center volt-glow">
      <div class="mx-auto grid size-16 place-items-center rounded-full bg-volt text-coal-950">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="size-8"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
      </div>
      <h3 class="display mt-5 text-2xl font-extrabold">Training afgerond</h3>
      <p class="mt-2 text-sm text-white/60" id="klaar-tekst">Sterk gedaan. Je voortgang is opgeslagen en Daan kan meekijken.</p>
      <a href="/app/" class="mt-6 block rounded-xl bg-volt py-3 font-semibold text-coal-950">Terug naar vandaag</a>
    </div>
  </div>

  <!-- Nieuw record -->
  <div id="pr-overlay" class="pointer-events-none fixed inset-0 z-[70] hidden items-center justify-center px-6">
    <div id="pr-kaart" class="scale-95 rounded-3xl border border-volt/40 bg-coal-900/95 px-8 py-7 text-center opacity-0 backdrop-blur-xl volt-glow transition-[transform,opacity] duration-200 ease-snap">
      <div class="mx-auto grid size-12 place-items-center rounded-full bg-volt text-coal-950">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="size-6"><path d="M8 21h8M12 17v4M7 4h10v4a5 5 0 0 1-10 0z"/><path d="M7 5.5H4.5a2.5 2.5 0 0 0 2.6 4M17 5.5h2.5a2.5 2.5 0 0 1-2.6 4"/></svg>
      </div>
      <p class="mt-3 font-display text-[11px] font-semibold uppercase tracking-[0.2em] text-volt">Nieuw record</p>
      <p class="display mt-1 text-2xl font-extrabold" id="pr-tekst"></p>
    </div>
  </div>

  <!-- Techniek-sheets: video plus spierkaart per oefening -->
  {
    alleOefeningen.map((oef) => {
      const spieren = OEFENING_SPIEREN[oef.id] ?? { primair: [], secundair: [] };
      return (
        <div class="techniek-sheet fixed inset-0 z-[75] hidden items-end justify-center lg:items-center" data-techniek-sheet={oef.id}>
          <div class="absolute inset-0 bg-coal-950/80 backdrop-blur-sm" data-techniek-dicht />
          <div class="sheet-paneel relative max-h-[92svh] w-full max-w-md translate-y-8 overflow-y-auto rounded-t-3xl border border-white/10 bg-coal-900 p-5 pb-10 opacity-0 transition-[transform,opacity] duration-300 ease-drawer lg:rounded-3xl lg:pb-5">
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="display text-xl font-extrabold">{oef.naam}</h3>
                <p class="mt-0.5 text-xs text-white/50">{oef.spiergroep} - {oef.sets} x {oef.reps}</p>
              </div>
              <button type="button" data-techniek-dicht aria-label="Sluiten" class="grid size-9 shrink-0 place-items-center rounded-full bg-white/8 text-white/70 transition-transform duration-150 ease-snap active:scale-90">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" class="size-4"><path d="M7 7l10 10M17 7L7 17" /></svg>
              </button>
            </div>

            <div class="mt-4 overflow-hidden rounded-2xl border border-white/8 bg-coal-950">
              <video
                src={`/video/oefeningen/${oef.id}.mp4`}
                class="aspect-square w-full object-cover"
                muted
                loop
                playsinline
                preload="none"
                data-techniek-video
              />
            </div>

            <div class="mt-5 rounded-2xl border border-white/8 bg-coal-800 p-4">
              <SpierKaart primair={spieren.primair} secundair={spieren.secundair} />
              <div class="mt-4 flex flex-col gap-1.5 text-xs">
                <p class="flex items-start gap-2">
                  <span class="mt-1 size-2.5 shrink-0 rounded-full bg-volt" />
                  <span class="text-white/70"><span class="font-semibold text-white">Primair:</span> {spierNamen(spieren.primair)}</span>
                </p>
                {spieren.secundair.length > 0 && (
                  <p class="flex items-start gap-2">
                    <span class="mt-1 size-2.5 shrink-0 rounded-full bg-volt/35" />
                    <span class="text-white/70"><span class="font-semibold text-white">Secundair:</span> {spierNamen(spieren.secundair)}</span>
                  </p>
                )}
              </div>
            </div>

            {oef.cue && (
              <p class="mt-4 rounded-2xl border border-volt/20 bg-volt/8 px-4 py-3 text-sm leading-relaxed text-white/80">
                <span class="font-semibold text-volt">Let op je houding:</span> {oef.cue}
              </p>
            )}
          </div>
        </div>
      );
    })
  }

  <script>
    import { loadState, patchState, dateKey } from "../../scripts/store";
    import { KRACHT_VERLOOP } from "../../data/demo";

    type SetLog = { kg: number | null; reps: number; done: boolean };

    // PR-detectie alleen voor de hoofdoefeningen met een bekende basis.
    const PR_BASIS: Record<string, { naam: string; kg: number }> = {
      squat: { naam: "Back squat", kg: 80 },
      bench: { naam: "Bench press", kg: 62.5 },
      deadlift: { naam: "Deadlift", kg: 100 },
    };

    function init(): void {
      if (!document.querySelector("#rust-timer")) return;

    const state = loadState();
    const vandaagKey = dateKey();

    function setSleutel(dag: string, oef: string): string {
      return `${vandaagKey}:${dag}:${oef}`;
    }

    // Dag wisselen
    const dagKnoppen = document.querySelectorAll<HTMLButtonElement>("[data-dagknop]");
    dagKnoppen.forEach((knop) => {
      knop.addEventListener("click", () => {
        const id = knop.dataset.dagknop!;
        dagKnoppen.forEach((k) => {
          const actief = k.dataset.dagknop === id;
          k.className = `dagknop shrink-0 rounded-xl px-4 py-2.5 text-left transition-colors border ${actief ? "bg-volt text-coal-950 border-volt" : "bg-coal-800 text-white/70 border-white/8"}`;
        });
        document.querySelectorAll<HTMLElement>("[data-dagsectie]").forEach((s) => {
          const actief = s.dataset.dagsectie === id;
          s.classList.toggle("flex", actief);
          s.classList.toggle("hidden", !actief);
        });
        werkVoortgangBij();
      });
    });

    // Rusttimer
    const timerEl = document.getElementById("rust-timer")!;
    const tijdEl = document.getElementById("rust-tijd")!;
    let timerId: ReturnType<typeof setInterval> | null = null;

    function startRust(sec: number): void {
      if (timerId) clearInterval(timerId);
      let rest = sec;
      const toon = () => {
        tijdEl.textContent = `${Math.floor(rest / 60)}:${String(rest % 60).padStart(2, "0")}`;
      };
      toon();
      timerEl.classList.remove("opacity-0", "translate-y-4");
      timerId = setInterval(() => {
        rest -= 1;
        toon();
        if (rest <= 0) {
          stopRust();
          navigator.vibrate?.(200);
        }
      }, 1000);
    }

    function stopRust(): void {
      if (timerId) clearInterval(timerId);
      timerId = null;
      timerEl.classList.add("opacity-0", "translate-y-4");
    }

    document.getElementById("rust-skip")!.addEventListener("click", stopRust);

    // Nieuw record vieren
    function vierPr(oefId: string, kg: number): void {
      const basis = PR_BASIS[oefId];
      if (!basis) return;
      const overlay = document.getElementById("pr-overlay")!;
      const prKaart = document.getElementById("pr-kaart")!;
      document.getElementById("pr-tekst")!.textContent = `${basis.naam} ${String(kg).replace(".", ",")} kg`;
      overlay.classList.remove("hidden");
      overlay.classList.add("flex");
      requestAnimationFrame(() => prKaart.classList.remove("scale-95", "opacity-0"));
      navigator.vibrate?.([80, 40, 120]);
      setTimeout(() => {
        prKaart.classList.add("scale-95", "opacity-0");
        setTimeout(() => {
          overlay.classList.add("hidden");
          overlay.classList.remove("flex");
        }, 220);
      }, 2400);
    }

    function checkPr(oefId: string, kg: number | null): void {
      if (kg === null || !PR_BASIS[oefId]) return;
      const eigen = (state.eigenPrs as Record<string, number> | undefined)?.[oefId] ?? 0;
      const record = Math.max(PR_BASIS[oefId]!.kg, eigen);
      if (kg > record) {
        patchState((s) => {
          (s as Record<string, unknown>).eigenPrs = { ...((s.eigenPrs as object) ?? {}), [oefId]: kg };
        });
        (state as Record<string, unknown>).eigenPrs = { ...((state.eigenPrs as object) ?? {}), [oefId]: kg };
        vierPr(oefId, kg);
      }
    }

    // Oefeningkaarten opbouwen: overrides van de trainer, set-logs, vorige-keer-hint
    const kaarten = document.querySelectorAll<HTMLElement>(".oefening-kaart");

    function chipKlasse(done: boolean): string {
      return `set-chip grid size-11 place-items-center rounded-xl border font-display text-sm font-bold transition-all ${
        done ? "bg-volt text-coal-950 border-volt" : "bg-coal-950 text-white/60 border-white/12 hover:border-white/30"
      }`;
    }

    function stepper(waardeTekst: string): HTMLElement {
      const blok = document.createElement("div");
      blok.className = "flex shrink-0 items-center gap-0.5 rounded-lg border border-white/10 bg-coal-800 p-0.5";
      blok.innerHTML = `
        <button type="button" data-stap="min" class="grid size-7 place-items-center rounded-md text-white/60" aria-label="Minder">-</button>
        <span class="min-w-11 text-center text-xs font-semibold tabular-nums" data-stap="waarde">${waardeTekst}</span>
        <button type="button" data-stap="plus" class="grid size-7 place-items-center rounded-md text-white/60" aria-label="Meer">+</button>`;
      return blok;
    }

    kaarten.forEach((kaart) => {
      const dag = kaart.dataset.dag!;
      const oef = kaart.dataset.oef!;
      const override = state.schemaOverrides?.[`${dag}:${oef}`];
      const sets = override?.sets ?? Number(kaart.dataset.sets);
      const reps = override?.reps ?? kaart.dataset.reps!;
      const basisGewicht = override?.gewicht ?? (kaart.dataset.gewicht ? Number(kaart.dataset.gewicht) : null);
      const rust = Number(kaart.dataset.rust);
      const sleutel = setSleutel(dag, oef);

      kaart.dataset.sets = String(sets);
      const setsRepsEl = kaart.querySelector('[data-veld="setsreps"]');
      if (setsRepsEl) setsRepsEl.textContent = `${sets} x ${reps}`;

      // Vorige keer: uit eerdere sessies, anders uit het krachtverloop
      const laatste = (state.laatsteSessies as Record<string, { kg: number | null; reps: number; sets: number }> | undefined)?.[oef];
      const verloop = KRACHT_VERLOOP[oef];
      let hint = "";
      if (laatste) {
        hint = `Vorige keer: ${laatste.sets} sets${laatste.kg !== null ? ` met ${laatste.kg} kg` : ""}`;
      } else if (verloop) {
        hint = `Vorige keer: ${verloop.punten[verloop.punten.length - 1]!.kg} kg`;
      }
      if (hint) {
        const hintEl = document.createElement("p");
        hintEl.className = "mt-2 text-xs text-white/40";
        hintEl.textContent = hint;
        kaart.querySelector('[data-veld="sets"]')!.before(hintEl);
      }

      const setsEl = kaart.querySelector<HTMLElement>('[data-veld="sets"]')!;
      const repsNumeriek = /^\d+$/.test(reps);
      const standaardKg = basisGewicht !== null ? (state.gewichten?.[oef] ?? basisGewicht) : null;

      // Set-logs: per set gewicht, herhalingen en klaar-status
      const bestaand = (state.setLogs as Record<string, SetLog[]> | undefined)?.[sleutel];
      const legacyDone = state.setsDone?.[sleutel];
      const logs: SetLog[] = Array.from({ length: sets }, (_, i) =>
        bestaand?.[i] ?? { kg: standaardKg, reps: repsNumeriek ? Number(reps) : 0, done: legacyDone?.[i] ?? false },
      );

      function bewaarLogs(): void {
        patchState((s) => {
          (s as Record<string, unknown>).setLogs = { ...((s.setLogs as object) ?? {}), [sleutel]: logs };
          s.setsDone = { ...(s.setsDone ?? {}), [sleutel]: logs.map((l) => l.done) };
        });
      }

      if (repsNumeriek && basisGewicht !== null) {
        // Volledige logger: chips + actieve-set-regel; de losse gewichtknop bovenin vervalt hier
        kaart.querySelector('[data-veld="gewichtblok"]')?.classList.add("hidden");

        let volgKg = logs.find((l) => !l.done)?.kg ?? standaardKg ?? 0;
        let volgReps = logs.find((l) => !l.done)?.reps ?? Number(reps);

        const logger = document.createElement("div");
        logger.className = "mt-3 flex items-center gap-2 rounded-xl border border-volt/20 bg-coal-950 p-1.5";

        const setLabel = document.createElement("span");
        setLabel.className = "display shrink-0 px-2 text-sm font-bold text-volt";

        const kgStepper = stepper(`${volgKg} kg`);
        const repsStepper = stepper(String(volgReps));
        const klaarKnop = document.createElement("button");
        klaarKnop.type = "button";
        klaarKnop.className = "min-w-0 flex-1 rounded-lg bg-volt py-2 text-sm font-bold text-coal-950 transition-transform duration-150 ease-snap active:scale-[0.96]";
        klaarKnop.textContent = "Klaar";

        logger.append(setLabel, kgStepper, repsStepper, klaarKnop);
        setsEl.after(logger);

        const kgWaarde = kgStepper.querySelector('[data-stap="waarde"]')!;
        const repsWaarde = repsStepper.querySelector('[data-stap="waarde"]')!;
        kgStepper.querySelector('[data-stap="min"]')!.addEventListener("click", () => {
          volgKg = Math.max(0, Math.round((volgKg - 2.5) * 10) / 10);
          kgWaarde.textContent = `${volgKg} kg`;
        });
        kgStepper.querySelector('[data-stap="plus"]')!.addEventListener("click", () => {
          volgKg = Math.round((volgKg + 2.5) * 10) / 10;
          kgWaarde.textContent = `${volgKg} kg`;
        });
        repsStepper.querySelector('[data-stap="min"]')!.addEventListener("click", () => {
          volgReps = Math.max(1, volgReps - 1);
          repsWaarde.textContent = String(volgReps);
        });
        repsStepper.querySelector('[data-stap="plus"]')!.addEventListener("click", () => {
          volgReps += 1;
          repsWaarde.textContent = String(volgReps);
        });

        function toonLogger(): void {
          const volgende = logs.findIndex((l) => !l.done);
          if (volgende === -1) {
            logger.innerHTML = '<p class="w-full py-1.5 text-center text-xs font-semibold text-volt">Alle sets gedaan, sterk</p>';
            return;
          }
          setLabel.textContent = `Set ${volgende + 1}`;
        }

        function toonChips(): void {
          setsEl.innerHTML = "";
          logs.forEach((log, i) => {
            const chip = document.createElement("button");
            chip.type = "button";
            chip.className = chipKlasse(log.done);
            chip.textContent = String(i + 1);
            chip.title = log.done && log.kg !== null ? `${log.kg} kg x ${log.reps}` : `Set ${i + 1}`;
            chip.setAttribute("aria-label", `Set ${i + 1}`);
            chip.addEventListener("click", () => {
              log.done = !log.done;
              if (log.done) {
                log.kg = volgKg;
                log.reps = volgReps;
                startRust(rust);
                checkPr(oef, volgKg);
              }
              bewaarLogs();
              toonChips();
              toonLogger();
              werkVoortgangBij();
            });
            setsEl.appendChild(chip);
          });
        }

        klaarKnop.addEventListener("click", () => {
          const volgende = logs.findIndex((l) => !l.done);
          if (volgende === -1) return;
          logs[volgende] = { kg: volgKg, reps: volgReps, done: true };
          bewaarLogs();
          patchState((s) => {
            s.gewichten = { ...(s.gewichten ?? {}), [oef]: volgKg };
          });
          startRust(rust);
          checkPr(oef, volgKg);
          toonChips();
          toonLogger();
          werkVoortgangBij();
        });

        toonChips();
        toonLogger();
      } else {
        // Eenvoudige variant: chips afvinken, eventueel met gewichtknop bovenin
        let gewicht = standaardKg;
        const gewichtEl = kaart.querySelector<HTMLElement>('[data-veld="gewicht"]');
        const toonGewicht = () => {
          if (gewichtEl && gewicht !== null) gewichtEl.textContent = `${gewicht} kg`;
        };
        toonGewicht();
        kaart.querySelector('[data-actie="gewicht-min"]')?.addEventListener("click", () => {
          if (gewicht === null) return;
          gewicht = Math.max(0, Math.round((gewicht - 2.5) * 10) / 10);
          toonGewicht();
          patchState((s) => {
            s.gewichten = { ...(s.gewichten ?? {}), [oef]: gewicht as number };
          });
        });
        kaart.querySelector('[data-actie="gewicht-plus"]')?.addEventListener("click", () => {
          if (gewicht === null) return;
          gewicht = Math.round((gewicht + 2.5) * 10) / 10;
          toonGewicht();
          patchState((s) => {
            s.gewichten = { ...(s.gewichten ?? {}), [oef]: gewicht as number };
          });
        });

        logs.forEach((log, i) => {
          const chip = document.createElement("button");
          chip.type = "button";
          chip.className = chipKlasse(log.done);
          chip.textContent = String(i + 1);
          chip.setAttribute("aria-label", `Set ${i + 1} afvinken`);
          chip.addEventListener("click", () => {
            log.done = !log.done;
            chip.className = chipKlasse(log.done);
            bewaarLogs();
            if (log.done) startRust(rust);
            werkVoortgangBij();
          });
          setsEl.appendChild(chip);
        });
      }
    });

    // Door de trainer toegevoegde oefeningen (uit de schema-editor op de trainerskant)
    const toevoegingen = state.schemaToevoegingen ?? {};
    document.querySelectorAll<HTMLElement>("[data-dagsectie]").forEach((sectie) => {
      const dag = sectie.dataset.dagsectie!;
      const afrondKnop = sectie.querySelector('[data-actie="afronden"]');
      (toevoegingen[dag] ?? []).forEach((naam, i) => {
        const kaart = document.createElement("article");
        kaart.className = "rounded-2xl border border-volt/20 bg-coal-800 p-5";
        kaart.innerHTML = `
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="display text-base font-bold">${naam}</h3>
              <p class="mt-0.5 text-xs text-white/45">3 x 10 - rust 1:30</p>
            </div>
            <span class="rounded-full bg-volt/10 px-2.5 py-1 text-[11px] font-semibold text-volt">Nieuw van Daan</span>
          </div>
          <div class="mt-4 flex flex-wrap gap-2" data-veld="sets"></div>`;
        const setsEl = kaart.querySelector<HTMLElement>('[data-veld="sets"]')!;
        const sleutel = setSleutel(dag, `extra-${i}`);
        const done: boolean[] = state.setsDone?.[sleutel] ?? Array(3).fill(false);
        for (let s = 0; s < 3; s++) {
          const chip = document.createElement("button");
          chip.type = "button";
          chip.className = chipKlasse(done[s] ?? false);
          chip.textContent = String(s + 1);
          chip.setAttribute("aria-label", `Set ${s + 1} afvinken`);
          chip.addEventListener("click", () => {
            done[s] = !done[s];
            chip.className = chipKlasse(done[s]!);
            patchState((st) => {
              st.setsDone = { ...(st.setsDone ?? {}), [sleutel]: done };
            });
            if (done[s]) startRust(90);
            werkVoortgangBij();
          });
          setsEl.appendChild(chip);
        }
        sectie.insertBefore(kaart, afrondKnop);
      });
    });

    // Voortgang van de zichtbare dag
    const voortgangBalk = document.getElementById("voortgang-balk")!;
    const voortgangLabel = document.getElementById("voortgang-label");

    function werkVoortgangBij(): void {
      const sectie = document.querySelector<HTMLElement>("[data-dagsectie].flex") ?? document.querySelector<HTMLElement>("[data-dagsectie]:not(.hidden)");
      if (!sectie) return;
      const chips = sectie.querySelectorAll(".set-chip");
      const klaar = sectie.querySelectorAll(".set-chip.bg-volt").length;
      const pct = chips.length ? Math.round((klaar / chips.length) * 100) : 0;
      voortgangBalk.style.width = `${pct}%`;
      if (voortgangLabel) voortgangLabel.textContent = `${pct}%`;
    }
    werkVoortgangBij();

    // Afronden: samenvatting maken en laatste sessie per oefening onthouden
    document.querySelectorAll<HTMLButtonElement>('[data-actie="afronden"]').forEach((knop) => {
      knop.addEventListener("click", () => {
        const dag = knop.dataset.dag!;
        const alleLogs = (loadState().setLogs as Record<string, SetLog[]> | undefined) ?? {};
        let setsGedaan = 0;
        let volume = 0;
        const sessies: Record<string, { kg: number | null; reps: number; sets: number; datum: string }> = {};
        Object.entries(alleLogs).forEach(([sleutel, logs]) => {
          if (!sleutel.startsWith(`${vandaagKey}:${dag}:`)) return;
          const oefId = sleutel.split(":").pop()!;
          const gedaan = logs.filter((l) => l.done);
          setsGedaan += gedaan.length;
          gedaan.forEach((l) => {
            if (l.kg !== null) volume += l.kg * l.reps;
          });
          if (gedaan.length) {
            sessies[oefId] = {
              kg: gedaan.reduce<number | null>((max, l) => (l.kg !== null && (max === null || l.kg > max) ? l.kg : max), null),
              reps: gedaan[gedaan.length - 1]!.reps,
              sets: gedaan.length,
              datum: vandaagKey,
            };
          }
        });
        patchState((s) => {
          s.trainingenAfgerond = { ...(s.trainingenAfgerond ?? {}), [vandaagKey]: dag };
          (s as Record<string, unknown>).laatsteSessies = { ...((s.laatsteSessies as object) ?? {}), ...sessies };
        });
        const klaarTekst = document.getElementById("klaar-tekst");
        if (klaarTekst && setsGedaan > 0) {
          klaarTekst.textContent =
            volume > 0
              ? `${setsGedaan} sets gedaan en ${Math.round(volume).toLocaleString("nl-NL")} kg totaal getild. Daan kan meekijken.`
              : `${setsGedaan} sets gedaan. Daan kan meekijken.`;
        }
        stopRust();
        const overlay = document.getElementById("klaar-overlay")!;
        overlay.classList.remove("hidden");
        overlay.classList.add("flex");
      });
    });

    // Techniek-sheets: video en spierkaart per oefening
    let openSheet: HTMLElement | null = null;

    function sluitTechniek(): void {
      if (!openSheet) return;
      const paneel = openSheet.querySelector<HTMLElement>(".sheet-paneel")!;
      const video = openSheet.querySelector<HTMLVideoElement>("[data-techniek-video]");
      video?.pause();
      paneel.classList.add("translate-y-8", "opacity-0");
      const sheet = openSheet;
      openSheet = null;
      setTimeout(() => {
        sheet.classList.add("hidden");
        sheet.classList.remove("flex");
      }, 300);
    }

    document.querySelectorAll<HTMLButtonElement>("[data-techniek-open]").forEach((knop) => {
      knop.addEventListener("click", () => {
        const sheet = document.querySelector<HTMLElement>(`[data-techniek-sheet="${knop.dataset.techniekOpen}"]`);
        if (!sheet) return;
        openSheet = sheet;
        sheet.classList.remove("hidden");
        sheet.classList.add("flex");
        const paneel = sheet.querySelector<HTMLElement>(".sheet-paneel")!;
        requestAnimationFrame(() => requestAnimationFrame(() => paneel.classList.remove("translate-y-8", "opacity-0")));
        sheet.querySelector<HTMLVideoElement>("[data-techniek-video]")?.play().catch(() => {});
      });
    });
    document.querySelectorAll<HTMLElement>("[data-techniek-dicht]").forEach((el) => {
      el.addEventListener("click", sluitTechniek);
    });

    // Lopende rusttimer stoppen en video's pauzeren zodra je wegnavigeert
    document.addEventListener(
      "astro:before-swap",
      () => {
        stopRust();
        document.querySelectorAll<HTMLVideoElement>("[data-techniek-video]").forEach((v) => v.pause());
      },
      { once: true },
    );
    }
    document.addEventListener("astro:page-load", init);
  </script>
</AppShell>
