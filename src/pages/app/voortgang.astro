---
import AppShell from "../../layouts/AppShell.astro";
import { PRS } from "../../data/demo";
---

<AppShell title="Voortgang | BASE app" paginaTitel="Voortgang" rol="lid">
  <section class="rise-in">
    <h2 class="display text-2xl font-extrabold">Jouw voortgang</h2>
    <p class="mt-1 text-sm text-white/50">De laatste 8 weken. Daan kijkt met je mee en stuurt je schema hierop bij.</p>
  </section>

  <!-- Progressie per oefening -->
  <section class="rise-in rise-in-1 mt-5 rounded-3xl border border-white/8 bg-coal-800 p-5 lg:p-6">
    <div class="flex items-center justify-between gap-3">
      <h3 class="display text-sm font-semibold text-white/85">Per oefening</h3>
      <span id="kracht-delta" class="shrink-0 rounded-full px-3 py-1 text-xs font-semibold"></span>
    </div>
    <label class="relative mt-3 block">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="pointer-events-none absolute left-3.5 top-1/2 size-4 -translate-y-1/2 text-white/40"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>
      <input
        type="search"
        id="oefening-zoek"
        placeholder="Zoek op oefening of spiergroep"
        class="w-full rounded-xl border border-white/10 bg-coal-950 py-2.5 pl-10 pr-4 text-sm placeholder:text-white/35 focus:border-volt/50 focus:outline-none"
      />
    </label>
    <div class="-mx-1 mt-3 flex gap-2 overflow-x-auto no-scrollbar px-1 pb-1" id="kracht-keuze"></div>
    <p id="oefening-leeg" class="mt-1 hidden text-xs text-white/40">Geen oefening gevonden.</p>
    <p id="spier-detail" class="mt-2 text-xs leading-relaxed text-white/45"></p>
    <div class="relative mt-4" id="kracht-grafiek"></div>
    <p class="mt-5 text-xs font-medium text-white/45">Laatste sessies</p>
    <div class="mt-2 flex flex-col gap-2" id="kracht-sessies"></div>
  </section>

  <!-- Lichaamsgewicht -->
  <section class="rise-in rise-in-2 mt-5 rounded-3xl border border-white/8 bg-coal-800 p-5 lg:p-6">
    <div class="flex items-center justify-between gap-3">
      <h3 class="display text-sm font-semibold text-white/85">Lichaamsgewicht</h3>
      <span id="gewicht-delta" class="shrink-0 rounded-full px-3 py-1 text-xs font-semibold"></span>
    </div>
    <p class="display mt-3 text-3xl font-extrabold" id="trend-getal"></p>
    <p class="mt-0.5 text-xs text-white/45">trendgewicht, dagschommelingen uitgemiddeld</p>
    <div class="relative mt-4" id="gewicht-grafiek"></div>
    <div class="mt-3 flex items-center gap-4 text-[11px] text-white/45">
      <span class="flex items-center gap-1.5"><span class="h-0.5 w-4 rounded bg-volt"></span>trendgewicht</span>
      <span class="flex items-center gap-1.5"><span class="w-4 border-t border-dashed border-white/40"></span>weging</span>
    </div>
    <form id="weeg-form" class="mt-4 flex gap-2" novalidate>
      <input
        id="weeg-input"
        type="text"
        inputmode="decimal"
        placeholder="Gewicht vandaag (kg)"
        class="min-w-0 flex-1 rounded-xl border border-white/10 bg-coal-950 px-3.5 py-2.5 text-sm placeholder:text-white/35 focus:border-volt/50 focus:outline-none transition-colors"
      />
      <button type="submit" class="shrink-0 rounded-xl bg-volt px-5 py-2.5 text-sm font-bold text-coal-950 transition-transform active:scale-[0.97]">Log</button>
    </form>
  </section>

  <!-- PR's -->
  <section class="rise-in rise-in-3 mt-5">
    <h3 class="display text-sm font-semibold text-white/85">Persoonlijke records</h3>
    <div class="mt-3 grid grid-cols-2 gap-3">
      {
        PRS.map((pr) => (
          <div class="rounded-2xl border border-white/8 bg-coal-800 p-4">
            <p class="text-xs text-white/50">{pr.oefening}</p>
            <p class="display mt-1 text-2xl font-extrabold">
              <span data-pr={pr.oefening}>{pr.kg}</span>
              <span class="text-sm font-semibold text-white/40"> {"eenheid" in pr ? pr.eenheid : "kg"}</span>
            </p>
            <p class="mt-1 text-[11px] text-white/40">{pr.datum}</p>
          </div>
        ))
      }
    </div>
  </section>

  <script>
    import { KRACHT_VERLOOP, WEGINGEN, SCHEMA, SPIEREN, OEFENING_SPIEREN } from "../../data/demo";
    import { loadState, patchState, dateKey } from "../../scripts/store";

    function init(): void {
      if (!document.querySelector("#kracht-grafiek")) return;

    type Punt = { datum: string; kg: number };

    const VOLT = "#d6fb00";

    function kortLabel(iso: string): string {
      return new Date(iso + "T12:00:00").toLocaleDateString("nl-NL", { day: "numeric", month: "short" });
    }

    // Compacte lijngrafiek: 2px lijn, rustig grid, tooltip bij aanwijzen.
    // Optioneel een tweede, ruwe serie (stippellijn) onder de hoofdlijn, voor wegingen naast het trendgewicht.
    function lijnGrafiek(container: HTMLElement, punten: Punt[], eenheid: string, ruw?: Punt[]): void {
      container.innerHTML = "";
      const W = 640;
      const H = 240;
      const pad = { l: 42, r: 18, t: 18, b: 30 };

      const waarden = [...punten, ...(ruw ?? [])].map((p) => p.kg);
      const min = Math.min(...waarden);
      const max = Math.max(...waarden);
      const marge = Math.max((max - min) * 0.25, 1);
      const y0 = min - marge;
      const y1 = max + marge;

      const x = (i: number) => pad.l + (i / (punten.length - 1)) * (W - pad.l - pad.r);
      const y = (v: number) => pad.t + (1 - (v - y0) / (y1 - y0)) * (H - pad.t - pad.b);

      const svgNs = "http://www.w3.org/2000/svg";
      const svg = document.createElementNS(svgNs, "svg");
      svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
      svg.setAttribute("class", "w-full");
      svg.setAttribute("role", "img");

      // Grid: 3 horizontale lijnen + y-labels
      for (let g = 0; g < 3; g++) {
        const v = y0 + ((g + 0.5) / 3) * (y1 - y0);
        const lijn = document.createElementNS(svgNs, "line");
        lijn.setAttribute("x1", String(pad.l));
        lijn.setAttribute("x2", String(W - pad.r));
        lijn.setAttribute("y1", String(y(v)));
        lijn.setAttribute("y2", String(y(v)));
        lijn.setAttribute("stroke", "rgba(255,255,255,0.07)");
        svg.appendChild(lijn);
        const label = document.createElementNS(svgNs, "text");
        label.setAttribute("x", String(pad.l - 8));
        label.setAttribute("y", String(y(v) + 3.5));
        label.setAttribute("text-anchor", "end");
        label.setAttribute("class", "fill-white/40");
        label.setAttribute("font-size", "11");
        label.textContent = String(Math.round(v * 10) / 10);
        svg.appendChild(label);
      }

      // X-labels: eerste, midden, laatste
      [0, Math.floor((punten.length - 1) / 2), punten.length - 1].forEach((i) => {
        const label = document.createElementNS(svgNs, "text");
        label.setAttribute("x", String(x(i)));
        label.setAttribute("y", String(H - 8));
        label.setAttribute("text-anchor", i === 0 ? "start" : i === punten.length - 1 ? "end" : "middle");
        label.setAttribute("class", "fill-white/40");
        label.setAttribute("font-size", "11");
        label.textContent = kortLabel(punten[i]!.datum);
        svg.appendChild(label);
      });

      // Vlak onder de lijn
      const defs = document.createElementNS(svgNs, "defs");
      const gradId = `grad-${container.id}`;
      defs.innerHTML = `<linearGradient id="${gradId}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${VOLT}" stop-opacity="0.22"/><stop offset="1" stop-color="${VOLT}" stop-opacity="0"/></linearGradient>`;
      svg.appendChild(defs);

      const vlakPad = punten.map((p, i) => `${i === 0 ? "M" : "L"}${x(i)},${y(p.kg)}`).join(" ");
      const vlak = document.createElementNS(svgNs, "path");
      vlak.setAttribute("d", `${vlakPad} L${x(punten.length - 1)},${H - pad.b} L${x(0)},${H - pad.b} Z`);
      vlak.setAttribute("fill", `url(#${gradId})`);
      svg.appendChild(vlak);

      // Ruwe serie: dunne stippellijn onder de hoofdlijn
      if (ruw) {
        const ruwPad = ruw.map((p, i) => `${i === 0 ? "M" : "L"}${x(i)},${y(p.kg)}`).join(" ");
        const ruwLijn = document.createElementNS(svgNs, "path");
        ruwLijn.setAttribute("d", ruwPad);
        ruwLijn.setAttribute("fill", "none");
        ruwLijn.setAttribute("stroke", "rgba(255,255,255,0.35)");
        ruwLijn.setAttribute("stroke-width", "1.2");
        ruwLijn.setAttribute("stroke-dasharray", "3 4");
        ruwLijn.setAttribute("stroke-linecap", "round");
        ruwLijn.setAttribute("stroke-linejoin", "round");
        svg.appendChild(ruwLijn);
      }

      const lijnPad = punten.map((p, i) => `${i === 0 ? "M" : "L"}${x(i)},${y(p.kg)}`).join(" ");
      const lijn = document.createElementNS(svgNs, "path");
      lijn.setAttribute("d", lijnPad);
      lijn.setAttribute("fill", "none");
      lijn.setAttribute("stroke", VOLT);
      lijn.setAttribute("stroke-width", "2");
      lijn.setAttribute("stroke-linecap", "round");
      lijn.setAttribute("stroke-linejoin", "round");
      svg.appendChild(lijn);

      // Punten: open, laatste gevuld met direct label. Bij lange reeksen alleen het laatste punt.
      punten.forEach((p, i) => {
        if (punten.length > 12 && i !== punten.length - 1) return;
        const dot = document.createElementNS(svgNs, "circle");
        dot.setAttribute("cx", String(x(i)));
        dot.setAttribute("cy", String(y(p.kg)));
        dot.setAttribute("r", "4");
        dot.setAttribute("fill", i === punten.length - 1 ? VOLT : "#161616");
        dot.setAttribute("stroke", VOLT);
        dot.setAttribute("stroke-width", "2");
        svg.appendChild(dot);
      });
      const laatste = punten[punten.length - 1]!;
      const eindLabel = document.createElementNS(svgNs, "text");
      eindLabel.setAttribute("x", String(x(punten.length - 1)));
      eindLabel.setAttribute("y", String(y(laatste.kg) - 12));
      eindLabel.setAttribute("text-anchor", "end");
      eindLabel.setAttribute("class", "fill-white");
      eindLabel.setAttribute("font-size", "13");
      eindLabel.setAttribute("font-weight", "600");
      eindLabel.textContent = `${laatste.kg} ${eenheid}`;
      svg.appendChild(eindLabel);

      container.appendChild(svg);

      // Tooltip + crosshair
      const tip = document.createElement("div");
      tip.className = "pointer-events-none absolute z-10 hidden rounded-lg border border-white/10 bg-coal-950/95 px-3 py-1.5 text-xs shadow-xl";
      container.appendChild(tip);
      const kruis = document.createElementNS(svgNs, "line");
      kruis.setAttribute("stroke", "rgba(255,255,255,0.25)");
      kruis.setAttribute("stroke-dasharray", "3 3");
      kruis.setAttribute("y1", String(pad.t));
      kruis.setAttribute("y2", String(H - pad.b));
      kruis.setAttribute("visibility", "hidden");
      svg.appendChild(kruis);

      const beweeg = (clientX: number) => {
        const rect = svg.getBoundingClientRect();
        const sx = ((clientX - rect.left) / rect.width) * W;
        let idx = Math.round(((sx - pad.l) / (W - pad.l - pad.r)) * (punten.length - 1));
        idx = Math.max(0, Math.min(punten.length - 1, idx));
        const p = punten[idx]!;
        const r = ruw?.[idx];
        kruis.setAttribute("x1", String(x(idx)));
        kruis.setAttribute("x2", String(x(idx)));
        kruis.setAttribute("visibility", "visible");
        tip.innerHTML = r
          ? `<span class="text-white/50">${kortLabel(p.datum)}</span> <span class="font-semibold">trend ${p.kg}</span> <span class="text-white/50">- weging ${r.kg}</span>`
          : `<span class="text-white/50">${kortLabel(p.datum)}</span> <span class="font-semibold">${p.kg} ${eenheid}</span>`;
        tip.classList.remove("hidden");
        const tx = (x(idx) / W) * rect.width;
        tip.style.left = `${Math.min(rect.width - (ruw ? 190 : 110), Math.max(4, tx - 40))}px`;
        tip.style.top = `${(y(p.kg) / H) * rect.height - 38}px`;
      };
      svg.addEventListener("mousemove", (e) => beweeg(e.clientX));
      svg.addEventListener("touchstart", (e) => beweeg(e.touches[0]!.clientX), { passive: true });
      svg.addEventListener("touchmove", (e) => beweeg(e.touches[0]!.clientX), { passive: true });
      svg.addEventListener("mouseleave", () => {
        tip.classList.add("hidden");
        kruis.setAttribute("visibility", "hidden");
      });

      // Toegankelijke tabelweergave
      const tabel = document.createElement("table");
      tabel.className = "sr-only block";
      tabel.innerHTML =
        `<caption>Verloop in ${eenheid}</caption>` +
        `<tr><th scope="col">Datum</th><th scope="col">Waarde</th></tr>` +
        punten.map((p) => `<tr><td>${kortLabel(p.datum)}</td><td>${p.kg} ${eenheid}</td></tr>`).join("");
      container.appendChild(tabel);
    }

    // Progressie per oefening: grafiek met keuzeknoppen en laatste sessies
    const keuzeEl = document.getElementById("kracht-keuze")!;
    const krachtEl = document.getElementById("kracht-grafiek")!;
    const deltaEl = document.getElementById("kracht-delta")!;
    const sessiesEl = document.getElementById("kracht-sessies")!;
    const sleutels = Object.keys(KRACHT_VERLOOP);

    // Sets, reps en spiergroep per oefening uit het schema, voor de sessieregels en het zoeken
    const oefInfo: Record<string, { sets: number; reps: string; spiergroep: string }> = {};
    SCHEMA.dagen.forEach((dag) => dag.oefeningen.forEach((oef) => { oefInfo[oef.id] = { sets: oef.sets, reps: oef.reps, spiergroep: oef.spiergroep }; }));

    // Badge in LiftLog-stijl: groen bij vooruitgang, rood bij achteruitgang, grijs bij gelijk
    function diffBadge(diff: number | null): string {
      if (diff === null) return "";
      if (diff > 0) return `<span class="shrink-0 rounded-full bg-emerald-400/10 px-2.5 py-1 text-[11px] font-semibold text-emerald-300">&#9650; +${diff}</span>`;
      if (diff < 0) return `<span class="shrink-0 rounded-full bg-red-400/10 px-2.5 py-1 text-[11px] font-semibold text-red-300">&#9660; ${diff}</span>`;
      return `<span class="shrink-0 rounded-full bg-white/5 px-2.5 py-1 text-[11px] font-semibold text-white/40">&asymp; gelijk</span>`;
    }

    // Vanaf de trainingspagina kun je direct naar een oefening springen
    const gevraagd = new URLSearchParams(location.search).get("oefening");
    let actief = gevraagd && KRACHT_VERLOOP[gevraagd] ? gevraagd : sleutels[0]!;

    function toonKracht(): void {
      const data = KRACHT_VERLOOP[actief]!;
      const punten = data.punten.map((p) => ({ ...p }));

      // Gewicht dat Sanne op de trainingspagina aanpaste telt als de sessie van vandaag
      const gelogd = data.eenheid === "kg" ? loadState().gewichten?.[actief] : undefined;
      if (gelogd !== undefined) punten[punten.length - 1] = { ...punten[punten.length - 1]!, kg: gelogd };

      lijnGrafiek(krachtEl, punten, data.eenheid);
      const delta = Math.round((punten[punten.length - 1]!.kg - punten[0]!.kg) * 10) / 10;
      deltaEl.textContent =
        delta > 0 ? `▲ +${delta} ${data.eenheid} in 8 weken` : delta < 0 ? `▼ ${delta} ${data.eenheid} in 8 weken` : "≈ gelijk gebleven";
      deltaEl.className = `shrink-0 rounded-full px-3 py-1 text-xs font-semibold ${
        delta > 0 ? "bg-emerald-400/10 text-emerald-300" : delta < 0 ? "bg-red-400/10 text-red-300" : "bg-white/5 text-white/40"
      }`;

      [...keuzeEl.children].forEach((kind) => {
        const knop = kind as HTMLButtonElement;
        const aan = knop.dataset.sleutel === actief;
        knop.className = `shrink-0 whitespace-nowrap rounded-lg px-3 py-1.5 text-xs font-semibold transition-colors ${aan ? "bg-volt text-coal-950" : "bg-coal-950 text-white/60 border border-white/10 hover:text-white"}`;
      });

      // Primaire en secundaire spieren van de gekozen oefening
      const spieren = OEFENING_SPIEREN[actief];
      const detailEl = document.getElementById("spier-detail")!;
      if (spieren) {
        const namen = (lijst: string[]) => lijst.map((id) => SPIEREN[id]?.naam ?? id).join(", ");
        detailEl.innerHTML =
          `<span class="font-semibold text-volt/90">Primair:</span> ${namen(spieren.primair)}` +
          `<span class="mx-1.5 text-white/25">·</span><span class="font-semibold text-white/60">Secundair:</span> ${namen(spieren.secundair)}`;
      } else {
        detailEl.innerHTML = "";
      }

      // Laatste sessies: nieuwste boven, met verschil ten opzichte van de sessie ervoor
      const info = oefInfo[actief];
      sessiesEl.innerHTML = "";
      for (let i = punten.length - 1; i >= Math.max(1, punten.length - 4); i--) {
        const p = punten[i]!;
        const diff = Math.round((p.kg - punten[i - 1]!.kg) * 10) / 10;
        const regel = document.createElement("div");
        regel.className = "flex items-center gap-3 rounded-xl border border-white/8 bg-coal-950 px-3.5 py-2.5";
        const setsTekst = info
          ? data.eenheid === "kg"
            ? `${info.sets} x ${info.reps} - ${p.kg} kg`
            : `${info.sets} sets - ${p.kg} ${data.eenheid}`
          : `${p.kg} ${data.eenheid}`;
        regel.innerHTML = `
          <span class="w-16 shrink-0 text-xs text-white/45">${kortLabel(p.datum)}</span>
          <span class="min-w-0 flex-1 truncate text-sm font-medium tabular-nums">${setsTekst}</span>
          ${diffBadge(diff)}`;
        sessiesEl.appendChild(regel);
      }
    }

    // Zoektermen per oefening: naam en grove groep, plus alle aliassen (NL en EN) van de
    // primaire en secundaire spieren. "chest" of "borst" vindt zo alle drukoefeningen,
    // "front delts" ook de presses waar die primair meewerken.
    function zoektermen(sleutel: string): { primair: string; secundair: string } {
      const spieren = OEFENING_SPIEREN[sleutel];
      const alias = (ids: string[]) => ids.flatMap((id) => [SPIEREN[id]?.naam ?? id, ...(SPIEREN[id]?.zoek ?? [])]);
      const primair = [KRACHT_VERLOOP[sleutel]!.naam, oefInfo[sleutel]?.spiergroep ?? "", ...alias(spieren?.primair ?? [])];
      const secundair = alias(spieren?.secundair ?? []);
      return { primair: primair.join(" ").toLowerCase(), secundair: secundair.join(" ").toLowerCase() };
    }

    sleutels.forEach((sleutel) => {
      const knop = document.createElement("button");
      knop.type = "button";
      knop.dataset.sleutel = sleutel;
      const termen = zoektermen(sleutel);
      knop.dataset.zoekPrimair = termen.primair;
      knop.dataset.zoekSecundair = termen.secundair;
      knop.textContent = KRACHT_VERLOOP[sleutel]!.naam;
      knop.addEventListener("click", () => {
        actief = sleutel;
        toonKracht();
      });
      keuzeEl.appendChild(knop);
    });
    toonKracht();

    // Zoeken filtert de keuzeknoppen: primaire treffers eerst, secundaire gedimd erachter
    const zoekInput = document.getElementById("oefening-zoek") as HTMLInputElement;
    const leegEl = document.getElementById("oefening-leeg")!;
    zoekInput.addEventListener("input", () => {
      const term = zoekInput.value.trim().toLowerCase();
      const primairRaak: HTMLButtonElement[] = [];
      const secundairRaak: HTMLButtonElement[] = [];
      [...keuzeEl.children].forEach((kind) => {
        const knop = kind as HTMLButtonElement;
        const inPrimair = knop.dataset.zoekPrimair!.includes(term);
        const inSecundair = !inPrimair && knop.dataset.zoekSecundair!.includes(term);
        knop.style.display = inPrimair || inSecundair ? "" : "none";
        knop.style.opacity = term && inSecundair ? "0.55" : "";
        if (inPrimair) primairRaak.push(knop);
        else if (inSecundair) secundairRaak.push(knop);
      });
      if (term) {
        [...primairRaak, ...secundairRaak].forEach((knop) => keuzeEl.appendChild(knop));
      } else {
        sleutels.forEach((s) => {
          const knop = keuzeEl.querySelector(`[data-sleutel="${s}"]`);
          if (knop) keuzeEl.appendChild(knop);
        });
      }
      leegEl.classList.toggle("hidden", primairRaak.length + secundairRaak.length > 0);
    });

    // Gekozen chip in beeld brengen als je via de trainingspagina binnenkomt
    if (gevraagd && KRACHT_VERLOOP[gevraagd]) {
      keuzeEl.querySelector<HTMLElement>(`[data-sleutel="${gevraagd}"]`)?.scrollIntoView({ inline: "center", block: "nearest" });
    }

    // Lichaamsgewicht: wegingen met daaroverheen het trendgewicht (EMA), zoals in LiftLog
    const gewichtEl = document.getElementById("gewicht-grafiek")!;
    const trendGetal = document.getElementById("trend-getal")!;
    const gewichtDelta = document.getElementById("gewicht-delta")!;

    function gewichtReeks(): { rij: Punt[]; trend: Punt[] } {
      const gelogd = loadState().wegingen ?? {};
      const map = new Map<string, number>();
      WEGINGEN.forEach((w) => map.set(w.datum, w.kg));
      Object.entries(gelogd).forEach(([datum, kg]) => map.set(datum, kg));
      const rij = [...map.entries()].sort((a, b) => (a[0] < b[0] ? -1 : 1)).map(([datum, kg]) => ({ datum, kg }));
      let ema: number | null = null;
      const trend = rij.map((p) => {
        ema = ema === null ? p.kg : ema * 0.7 + p.kg * 0.3;
        return { datum: p.datum, kg: Math.round(ema * 10) / 10 };
      });
      return { rij, trend };
    }

    function toonGewicht(): void {
      const { rij, trend } = gewichtReeks();
      lijnGrafiek(gewichtEl, trend, "kg", rij);
      const laatste = trend[trend.length - 1]!;
      trendGetal.innerHTML = `${laatste.kg.toFixed(1)} <span class="text-lg text-white/40">kg</span>`;

      // Delta van het trendgewicht over de laatste 30 dagen; afvallen kleurt groen
      const grens = new Date();
      grens.setDate(grens.getDate() - 30);
      const cutoff = dateKey(grens);
      const oud = [...trend].filter((p) => p.datum <= cutoff).pop() ?? trend[0]!;
      const d30 = Math.round((laatste.kg - oud.kg) * 10) / 10;
      gewichtDelta.textContent = d30 < 0 ? `▼ ${Math.abs(d30)} kg in 30 dagen` : d30 > 0 ? `▲ +${d30} kg in 30 dagen` : "≈ stabiel";
      gewichtDelta.className = `shrink-0 rounded-full px-3 py-1 text-xs font-semibold ${
        d30 < 0 ? "bg-emerald-400/10 text-emerald-300" : d30 > 0 ? "bg-red-400/10 text-red-300" : "bg-white/5 text-white/40"
      }`;
    }
    toonGewicht();

    // Gewicht van vandaag loggen: telt direct mee in de grafiek en het trendgewicht
    const weegForm = document.getElementById("weeg-form") as HTMLFormElement;
    const weegInput = document.getElementById("weeg-input") as HTMLInputElement;
    weegForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const waarde = Number(weegInput.value.trim().replace(",", "."));
      if (!Number.isFinite(waarde) || waarde < 30 || waarde > 250) {
        weegInput.classList.add("border-red-400/60");
        setTimeout(() => weegInput.classList.remove("border-red-400/60"), 1200);
        return;
      }
      patchState((s) => {
        s.wegingen = { ...(s.wegingen ?? {}), [dateKey()]: Math.round(waarde * 10) / 10 };
      });
      weegInput.value = "";
      weegInput.blur();
      toonGewicht();
    });
    }
    document.addEventListener("astro:page-load", init);
  </script>

  <script>
    import { loadState } from "../../scripts/store";

    // Records die tijdens een training zijn verbeterd, meenemen in de PR-kaarten.
    const NAAM_PER_ID: Record<string, string> = { squat: "Back squat", bench: "Bench press", deadlift: "Deadlift" };

    function initEigenPrs(): void {
      if (!document.querySelector("[data-pr]")) return;
      const eigen = (loadState().eigenPrs as Record<string, number> | undefined) ?? {};
      Object.entries(eigen).forEach(([id, kg]) => {
        const naam = NAAM_PER_ID[id];
        if (!naam) return;
        document.querySelectorAll<HTMLElement>("[data-pr]").forEach((el) => {
          if (el.dataset.pr === naam && kg > Number(el.textContent!.replace(",", "."))) {
            el.textContent = String(kg);
            el.closest(".rounded-2xl")?.classList.add("border-volt/40");
          }
        });
      });
    }
    document.addEventListener("astro:page-load", initEigenPrs);
  </script>
</AppShell>
