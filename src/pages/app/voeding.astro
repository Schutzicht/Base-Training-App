---
import AppShell from "../../layouts/AppShell.astro";
import { VOEDING } from "../../data/demo";

const { doelen, maaltijden, waterDoel } = VOEDING;
---

<AppShell title="Voeding | BASE app" paginaTitel="Voeding" rol="lid">
  <section class="rise-in">
    <h2 class="display text-2xl font-extrabold">Jouw voedingsplan</h2>
    <p class="mt-1 text-sm text-white/50">Samengesteld met Daan. Vink af wat je hebt gegeten, dan zie je direct waar je staat.</p>
  </section>

  <section class="rise-in rise-in-1 mt-5 rounded-3xl border border-white/8 bg-coal-800 p-6">
    <div class="flex items-baseline justify-between">
      <p class="display text-3xl font-extrabold"><span id="kcal-nu">0</span><span class="text-lg text-white/40"> / {doelen.kcal} kcal</span></p>
      <p class="text-xs text-white/45">vandaag</p>
    </div>
    <div class="mt-3 h-2 overflow-hidden rounded-full bg-white/8">
      <div id="kcal-balk" class="h-full w-0 rounded-full bg-volt transition-all duration-500"></div>
    </div>

    <div class="mt-6 grid grid-cols-3 gap-4">
      {
        [
          { id: "eiwit", label: "Eiwit", doel: doelen.eiwit },
          { id: "khd", label: "Koolhydraten", doel: doelen.koolhydraten },
          { id: "vet", label: "Vet", doel: doelen.vet },
        ].map((m) => (
          <div>
            <p class="text-[11px] text-white/45">{m.label}</p>
            <p class="mt-0.5 text-sm font-semibold tabular-nums">
              <span id={`${m.id}-nu`}>0</span>
              <span class="text-white/40"> / {m.doel} g</span>
            </p>
            <div class="mt-1.5 h-1 overflow-hidden rounded-full bg-white/8">
              <div id={`${m.id}-balk`} class="h-full w-0 rounded-full bg-volt/70 transition-all duration-500" />
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="rise-in rise-in-2 mt-5 flex flex-col gap-3">
    {
      maaltijden.map((m, i) => (
        <button
          type="button"
          class="maaltijd group flex items-center gap-4 rounded-2xl border border-white/8 bg-coal-800 p-4 text-left transition-colors"
          data-index={i}
          data-kcal={m.kcal}
          data-eiwit={m.eiwit}
          data-khd={m.koolhydraten}
          data-vet={m.vet}
        >
          <span class="maaltijd-vink grid size-7 shrink-0 place-items-center rounded-full border-2 border-white/20 text-transparent transition-colors">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
          </span>
          <span class="min-w-0 flex-1">
            <span class="flex items-baseline justify-between gap-3">
              <span class="display text-sm font-bold">{m.naam}</span>
              <span class="shrink-0 text-[11px] text-white/40">{m.tijd}</span>
            </span>
            <span class="mt-0.5 block truncate text-[13px] text-white/55">{m.omschrijving}</span>
            <span class="mt-1 block text-[11px] text-white/40">{m.kcal} kcal - {m.eiwit} g eiwit</span>
          </span>
        </button>
      ))
    }
  </section>

  <section class="rise-in rise-in-3 mt-5 rounded-2xl border border-white/8 bg-coal-800 p-5">
    <div class="flex items-center justify-between">
      <div>
        <h3 class="display text-sm font-semibold">Water</h3>
        <p class="text-xs text-white/45"><span id="water-nu">0</span> van {waterDoel} glazen</p>
      </div>
    </div>
    <div class="mt-4 flex gap-2" id="water-rij"></div>
  </section>

  <script>
    import { loadState, patchState, dateKey } from "../../scripts/store";

    const vandaag = dateKey();
    const state = loadState();

    // Maaltijden afvinken
    const kaarten = [...document.querySelectorAll<HTMLButtonElement>(".maaltijd")];
    const done: boolean[] = state.maaltijdenDone?.[vandaag] ?? Array(kaarten.length).fill(false);

    function toonMaaltijd(kaart: HTMLButtonElement, aan: boolean): void {
      const vink = kaart.querySelector(".maaltijd-vink")!;
      vink.className = `maaltijd-vink grid size-7 shrink-0 place-items-center rounded-full border-2 transition-colors ${
        aan ? "border-volt bg-volt text-coal-950" : "border-white/20 text-transparent"
      }`;
      kaart.classList.toggle("border-volt/30", aan);
      kaart.classList.toggle("bg-volt/6", aan);
    }

    function telOp(): void {
      let kcal = 0, eiwit = 0, khd = 0, vet = 0;
      kaarten.forEach((k, i) => {
        if (done[i]) {
          kcal += Number(k.dataset.kcal);
          eiwit += Number(k.dataset.eiwit);
          khd += Number(k.dataset.khd);
          vet += Number(k.dataset.vet);
        }
      });
      const zet = (id: string, nu: number, doel: number) => {
        document.getElementById(`${id}-nu`)!.textContent = String(nu);
        document.getElementById(`${id}-balk`)!.style.width = `${Math.min(100, (nu / doel) * 100)}%`;
      };
      zet("kcal", kcal, 2100);
      zet("eiwit", eiwit, 140);
      zet("khd", khd, 210);
      zet("vet", vet, 70);
    }

    kaarten.forEach((kaart, i) => {
      toonMaaltijd(kaart, done[i] ?? false);
      kaart.addEventListener("click", () => {
        done[i] = !done[i];
        toonMaaltijd(kaart, done[i]!);
        patchState((s) => {
          s.maaltijdenDone = { ...(s.maaltijdenDone ?? {}), [vandaag]: done };
        });
        telOp();
      });
    });
    telOp();

    // Water
    const waterRij = document.getElementById("water-rij")!;
    const waterNu = document.getElementById("water-nu")!;
    const WATER_DOEL = 8;
    let water = state.water?.[vandaag] ?? 0;

    function toonWater(): void {
      waterNu.textContent = String(water);
      waterRij.innerHTML = "";
      for (let i = 0; i < WATER_DOEL; i++) {
        const knop = document.createElement("button");
        knop.type = "button";
        const vol = i < water;
        knop.className = `flex-1 rounded-xl border py-3 transition-colors ${vol ? "border-volt/40 bg-volt/20" : "border-white/10 bg-coal-950 hover:border-white/25"}`;
        knop.setAttribute("aria-label", `Glas ${i + 1}`);
        knop.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="${vol ? "#d6fb00" : "rgba(255,255,255,0.35)"}" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="mx-auto size-5"><path d="M7 3.5h10l-1.2 16a1.8 1.8 0 0 1-1.8 1.5h-4a1.8 1.8 0 0 1-1.8-1.5z"/><path d="M7.8 12h8.4"/></svg>`;
        knop.addEventListener("click", () => {
          water = i < water ? i : i + 1;
          patchState((s) => {
            s.water = { ...(s.water ?? {}), [vandaag]: water };
          });
          toonWater();
        });
        waterRij.appendChild(knop);
      }
    }
    toonWater();
  </script>
</AppShell>
