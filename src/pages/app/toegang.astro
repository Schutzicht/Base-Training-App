---
import AppShell from "../../layouts/AppShell.astro";
import { LID } from "../../data/demo";
---

<AppShell title="Toegang | BASE app" paginaTitel="Toegang" rol="lid">
  <div class="mx-auto flex max-w-sm flex-col items-center pt-2 lg:pt-6">
    <div class="rise-in flex items-center gap-2 rounded-full border border-volt/30 bg-volt/10 px-4 py-1.5">
      <span class="size-2 rounded-full bg-volt animate-pulse-soft"></span>
      <span class="text-xs font-semibold text-volt">Membership actief</span>
    </div>

    <h2 class="rise-in rise-in-1 display mt-5 text-center text-3xl font-extrabold leading-tight">Scan bij de deur</h2>
    <p class="rise-in rise-in-1 mt-2 text-center text-sm text-white/55">
      Houd deze code voor de scanner bij de ingang. Je hebt 24/7 toegang tot de studio.
    </p>

    <div class="rise-in rise-in-2 mt-7 w-full rounded-3xl border border-volt/20 bg-coal-900 p-6 volt-glow">
      <div class="rounded-2xl bg-white p-5">
        <canvas id="qr-canvas" class="mx-auto aspect-square w-full max-w-60"></canvas>
      </div>
      <div class="mt-5 flex items-center justify-between">
        <div>
          <p class="display text-base font-bold">{LID.naam}</p>
          <p class="text-xs text-white/50">{LID.membership} - {LID.lidnummer}</p>
        </div>
        <img src="/img/logo-base-wit.png" alt="BASE" class="h-4 w-auto opacity-70" />
      </div>
      <div class="mt-4">
        <div class="flex items-center justify-between text-[11px] text-white/45">
          <span>Code vernieuwt automatisch</span>
          <span id="qr-teller" class="tabular-nums">30 sec</span>
        </div>
        <div class="mt-1.5 h-1 overflow-hidden rounded-full bg-white/10">
          <div id="qr-balk" class="h-full w-full rounded-full bg-volt transition-[width] duration-1000 ease-linear"></div>
        </div>
      </div>
    </div>

    <p class="rise-in rise-in-3 mt-5 text-center text-xs text-white/35">
      Werkt de scanner niet? Bel de studio via 06 29 01 52 15.
    </p>
  </div>

  <script>
    import QRCode from "qrcode";
    import { LID } from "../../data/demo";

    const canvas = document.getElementById("qr-canvas") as HTMLCanvasElement;
    const teller = document.getElementById("qr-teller")!;
    const balk = document.getElementById("qr-balk")!;
    const VENSTER = 30;

    function tekenQr(): void {
      const slot = Math.floor(Date.now() / (VENSTER * 1000));
      const payload = `BASE-TOEGANG|${LID.lidnummer}|${slot.toString(36).toUpperCase()}`;
      QRCode.toCanvas(canvas, payload, {
        width: 480,
        margin: 1,
        color: { dark: "#0a0a0a", light: "#ffffff" },
        errorCorrectionLevel: "M",
      });
    }

    tekenQr();
    setInterval(() => {
      const inSlot = Math.floor((Date.now() / 1000) % VENSTER);
      const rest = VENSTER - inSlot;
      teller.textContent = `${rest} sec`;
      balk.style.width = `${(rest / VENSTER) * 100}%`;
      if (inSlot === 0) tekenQr();
    }, 1000);
  </script>
</AppShell>
