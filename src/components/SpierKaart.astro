---
// Gestileerd spierfiguur (voor- en achteraanzicht). Regio's lichten op in volt:
// primair vol, secundair gedimd. Sluit aan op de spier-slugs uit OEFENING_SPIEREN.
interface Props {
  primair: string[];
  secundair: string[];
}

const { primair, secundair } = Astro.props;

function cls(id: string): string {
  if (primair.includes(id)) return "spier-primair";
  if (secundair.includes(id)) return "spier-secundair";
  return "spier-basis";
}

// Sommige logische regio's delen een getekende vorm.
function combi(ids: string[]): string {
  if (ids.some((id) => primair.includes(id))) return "spier-primair";
  if (ids.some((id) => secundair.includes(id))) return "spier-secundair";
  return "spier-basis";
}
---

<div class="flex items-start justify-center gap-6">
  <!-- Vooraanzicht -->
  <figure class="flex flex-col items-center">
    <svg viewBox="0 0 140 292" class="w-24 lg:w-28" aria-hidden="true">
      <!-- lijf-basis -->
      <circle cx="70" cy="20" r="12" class="spier-lijf" />
      <rect x="63" y="32" width="14" height="10" rx="4" class="spier-lijf" />
      <rect x="44" y="40" width="52" height="64" rx="14" class="spier-lijf" />
      <rect x="50" y="100" width="40" height="56" rx="12" class="spier-lijf" />
      <rect x="22" y="46" width="16" height="104" rx="8" class="spier-lijf" />
      <rect x="102" y="46" width="16" height="104" rx="8" class="spier-lijf" />
      <rect x="46" y="152" width="48" height="20" rx="8" class="spier-lijf" />
      <rect x="47" y="160" width="21" height="70" rx="9" class="spier-lijf" />
      <rect x="72" y="160" width="21" height="70" rx="9" class="spier-lijf" />
      <rect x="49" y="232" width="17" height="52" rx="8" class="spier-lijf" />
      <rect x="74" y="232" width="17" height="52" rx="8" class="spier-lijf" />

      <!-- traps (bovenkant schouders) -->
      <path d="M50 40 Q60 34 63 40 L63 46 L50 48 Z" class={cls("traps")} />
      <path d="M90 40 Q80 34 77 40 L77 46 L90 48 Z" class={cls("traps")} />
      <!-- schouderkoppen: buitenring = side-delts, kern = front-delts -->
      <circle cx="34" cy="52" r="11" class={cls("side-delts")} />
      <circle cx="106" cy="52" r="11" class={cls("side-delts")} />
      <circle cx="36" cy="53" r="6.5" class={cls("front-delts")} />
      <circle cx="104" cy="53" r="6.5" class={cls("front-delts")} />
      <!-- borst in drie banden -->
      <rect x="47" y="46" width="22" height="12" rx="5" class={cls("upper-chest")} />
      <rect x="71" y="46" width="22" height="12" rx="5" class={cls("upper-chest")} />
      <rect x="47" y="60" width="22" height="13" rx="5" class={cls("mid-chest")} />
      <rect x="71" y="60" width="22" height="13" rx="5" class={cls("mid-chest")} />
      <rect x="49" y="75" width="20" height="9" rx="4" class={cls("lower-chest")} />
      <rect x="71" y="75" width="20" height="9" rx="4" class={cls("lower-chest")} />
      <!-- armen -->
      <rect x="25" y="64" width="13" height="38" rx="6.5" class={cls("biceps")} />
      <rect x="102" y="64" width="13" height="38" rx="6.5" class={cls("biceps")} />
      <rect x="24" y="106" width="12" height="42" rx="6" class={cls("forearms")} />
      <rect x="104" y="106" width="12" height="42" rx="6" class={cls("forearms")} />
      <!-- romp -->
      <rect x="58" y="88" width="24" height="62" rx="8" class={cls("abs")} />
      <rect x="46" y="92" width="10" height="52" rx="5" class={cls("obliques")} />
      <rect x="84" y="92" width="10" height="52" rx="5" class={cls("obliques")} />
      <!-- benen -->
      <rect x="47" y="158" width="20" height="66" rx="9" class={cls("quads")} />
      <rect x="73" y="158" width="20" height="66" rx="9" class={cls("quads")} />
      <rect x="64" y="160" width="12" height="46" rx="6" class={cls("adductors")} />
    </svg>
    <figcaption class="mt-2 text-[10px] uppercase tracking-wider text-white/35">Voor</figcaption>
  </figure>

  <!-- Achteraanzicht -->
  <figure class="flex flex-col items-center">
    <svg viewBox="0 0 140 292" class="w-24 lg:w-28" aria-hidden="true">
      <!-- lijf-basis -->
      <circle cx="70" cy="20" r="12" class="spier-lijf" />
      <rect x="63" y="32" width="14" height="10" rx="4" class="spier-lijf" />
      <rect x="44" y="40" width="52" height="64" rx="14" class="spier-lijf" />
      <rect x="50" y="100" width="40" height="56" rx="12" class="spier-lijf" />
      <rect x="22" y="46" width="16" height="104" rx="8" class="spier-lijf" />
      <rect x="102" y="46" width="16" height="104" rx="8" class="spier-lijf" />
      <rect x="47" y="160" width="21" height="70" rx="9" class="spier-lijf" />
      <rect x="72" y="160" width="21" height="70" rx="9" class="spier-lijf" />

      <!-- traps: ruit vanaf de nek -->
      <path d="M70 34 L50 46 L60 66 L70 60 L80 66 L90 46 Z" class={cls("traps")} />
      <!-- schouderkoppen achter -->
      <circle cx="34" cy="52" r="10" class={cls("rear-delts")} />
      <circle cx="106" cy="52" r="10" class={cls("rear-delts")} />
      <!-- rotator cuff: kleine plaatjes op de schouderbladen -->
      <rect x="48" y="58" width="9" height="12" rx="4" class={cls("rotator-cuff")} />
      <rect x="83" y="58" width="9" height="12" rx="4" class={cls("rotator-cuff")} />
      <!-- bovenrug tussen de schouderbladen -->
      <rect x="54" y="68" width="32" height="16" rx="6" class={cls("upper-back")} />
      <!-- lats: vleugels naar de taille -->
      <path d="M48 84 L62 86 L60 128 L52 122 Q46 104 48 84 Z" class={cls("lats")} />
      <path d="M92 84 L78 86 L80 128 L88 122 Q94 104 92 84 Z" class={cls("lats")} />
      <!-- onderrug -->
      <rect x="61" y="122" width="18" height="28" rx="6" class={cls("lower-back")} />
      <!-- armen -->
      <rect x="25" y="64" width="13" height="38" rx="6.5" class={cls("triceps")} />
      <rect x="102" y="64" width="13" height="38" rx="6.5" class={cls("triceps")} />
      <rect x="24" y="106" width="12" height="42" rx="6" class={cls("forearms")} />
      <rect x="104" y="106" width="12" height="42" rx="6" class={cls("forearms")} />
      <!-- bilspieren -->
      <ellipse cx="59" cy="164" rx="13" ry="14" class={cls("glutes")} />
      <ellipse cx="81" cy="164" rx="13" ry="14" class={cls("glutes")} />
      <!-- hamstrings -->
      <rect x="47" y="182" width="20" height="46" rx="9" class={cls("hamstrings")} />
      <rect x="73" y="182" width="20" height="46" rx="9" class={cls("hamstrings")} />
      <!-- kuiten -->
      <rect x="49" y="234" width="17" height="44" rx="8" class={cls("calves")} />
      <rect x="74" y="234" width="17" height="44" rx="8" class={cls("calves")} />
    </svg>
    <figcaption class="mt-2 text-[10px] uppercase tracking-wider text-white/35">Achter</figcaption>
  </figure>
</div>
